{
  "name": "@buginbox/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/api.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --experimental-strip-types --watch src/api.ts",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "migrate": "node --experimental-strip-types src/db/migrate.ts",
    "seed": "node --experimental-strip-types src/db/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@buginbox/shared": "*",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.3",
    "@node-rs/argon2": "2.2.1",
    "bullmq": "6.3.6",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.0",
    "ioredis": "5.11.1",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "rate-limiter-flexible": "11.2.0",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "vitest": "3.2.7"
  }
}
