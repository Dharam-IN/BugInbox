# BugInbox production environment.
#
# Copy to /opt/buginbox/.env on the server, fill it in, then chmod 600.
# This file is a template of placeholders and must never contain a real secret.
# The real .env lives only on the server: it is not in Git, and the deployment
# pipeline never reads or writes it.
#
#   install -m 600 /dev/null /opt/buginbox/.env
#
# Do not put a '$' in any value. Compose interpolates it before the container
# sees it, so the database would be created with one password and connected to
# with another, and the only symptom is an authentication failure that looks
# nothing like its cause. `openssl rand -base64` never emits one.

# --- Networking ---------------------------------------------------------------
# The existing Docker network your Caddy container is on. Caddy is managed by
# you, outside this project; the stack only attaches its web container to this
# network and never creates or changes it. Find the name with:
#   docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}' <caddy-container>
BUGINBOX_EDGE_NETWORK=caddy_default

# That same network's subnet, the only source whose X-Forwarded-For the web
# tier believes. Find it with:
#   docker network inspect -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}' <network>
# Getting this wrong does not break the site; it breaks per-IP rate limiting
# and the address recorded against each report.
BUGINBOX_EDGE_CIDR=172.18.0.0/16

# BugInbox's own private network. Must not overlap 172.31.0.0/16 (the default
# AWS VPC range) or any other Docker network on the instance. Check with:
#   docker network inspect $(docker network ls -q) \
#     -f '{{.Name}} {{range .IPAM.Config}}{{.Subnet}}{{end}}'
BUGINBOX_INTERNAL_SUBNET=10.83.0.0/24

# --- Images ---------------------------------------------------------------------
# Optional. The stack defaults to the `latest` tag, which is what the deploy
# workflow pushes. Set these to a specific build to pin it by hand, e.g.
#   BUGINBOX_SERVER_IMAGE=ghcr.io/dharam-in/buginbox-server:sha-1a2b3c4
# BUGINBOX_SERVER_IMAGE=
# BUGINBOX_WEB_IMAGE=

# --- Application -------------------------------------------------------------------
LOG_LEVEL=info
# The public https origin. Both must match what Caddy serves, or emailed
# verification, reset and report links point at the wrong place.
APP_BASE_URL=https://buginbox.example.com
PUBLIC_BASE_URL=https://buginbox.example.com
SESSION_TTL_HOURS=336

# NODE_ENV, COOKIE_SECURE, DATABASE_URL, REDIS_URL, STORAGE_DIR and
# TRUSTED_PROXIES are set by docker-compose.prod.yml and are deliberately not
# listed here.

# --- Datastores -----------------------------------------------------------------------
# Generate with: openssl rand -base64 33
POSTGRES_USER=buginbox
POSTGRES_PASSWORD=
POSTGRES_DB=buginbox

# --- Email -----------------------------------------------------------------------------
# A real SMTP server. There is no Mailpit here, so a wrong value means owners
# never receive verification, password reset or report notification email.
# MAIL_FROM must be an address the provider has authorised you to send as, on a
# domain with the SPF and DKIM records that provider asks for.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BugInbox <no-reply@buginbox.example.com>"

# --- Storage and limits ---------------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_DIMENSION=10000
DEFAULT_RETENTION_DAYS=90
PROJECT_REPORT_CAP=5000
PROJECT_STORAGE_CAP_BYTES=262144000
MAX_PROJECTS_PER_OWNER=25

# --- Abuse limits ----------------------------------------------------------------------------
INGEST_RATE_PER_IP=10
INGEST_RATE_PER_IP_WINDOW_S=600
INGEST_RATE_PER_PROJECT=120
INGEST_RATE_PER_PROJECT_WINDOW_S=3600
CONFIG_RATE_PER_IP=120
CONFIG_RATE_PER_IP_WINDOW_S=60
AUTH_RATE_PER_IP=20
AUTH_RATE_PER_IP_WINDOW_S=900

# --- Widget / worker --------------------------------------------------------------------------
WIDGET_CONFIG_CACHE_S=300
WORKER_POLL_INTERVAL_MS=15000
NOTIFICATION_MAX_ATTEMPTS=8
