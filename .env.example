# BugInbox local environment. Copy to .env and adjust if a port is already taken.
# This file must only ever contain local development placeholders.

# --- Published loopback ports (host side) -----------------------------------
# All published ports bind to 127.0.0.1 so nothing is exposed on your network.
BUGINBOX_WEB_PORT=58080        # dashboard + API + widget script
BUGINBOX_FIXTURE_PORT=58081    # integration fixture host website
BUGINBOX_MAILPIT_PORT=58025    # Mailpit web UI and API
BUGINBOX_SMTP_PORT=51025       # Mailpit SMTP, used by host-run tests
BUGINBOX_POSTGRES_PORT=55432   # Postgres, for running tests from the host
BUGINBOX_REDIS_PORT=56379      # Redis, for running tests from the host

# --- Application -------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
APP_BASE_URL=http://localhost:58080
PUBLIC_BASE_URL=http://localhost:58080

# --- Datastores (local development credentials only) -------------------------
POSTGRES_USER=buginbox
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=buginbox
DATABASE_URL=postgres://buginbox:change-me-locally@postgres:5432/buginbox
REDIS_URL=redis://redis:6379

# --- Email (Mailpit only in local development) -------------------------------
# Never point these at a production email provider from this file.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="BugInbox <no-reply@buginbox.test>"

# --- Storage and limits ------------------------------------------------------
STORAGE_DIR=/data/uploads
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_DIMENSION=10000
DEFAULT_RETENTION_DAYS=90
PROJECT_REPORT_CAP=5000
PROJECT_STORAGE_CAP_BYTES=262144000
MAX_PROJECTS_PER_OWNER=25

# --- Security ----------------------------------------------------------------
# Exact address of the reverse proxy in the compose network. Only this address
# may set X-Forwarded-For. Leave empty when the API is reached directly.
TRUSTED_PROXIES=172.31.250.10
COOKIE_SECURE=false
SESSION_TTL_HOURS=336

# --- Abuse limits ------------------------------------------------------------
INGEST_RATE_PER_IP=10
INGEST_RATE_PER_IP_WINDOW_S=600
INGEST_RATE_PER_PROJECT=120
INGEST_RATE_PER_PROJECT_WINDOW_S=3600
CONFIG_RATE_PER_IP=120
CONFIG_RATE_PER_IP_WINDOW_S=60
AUTH_RATE_PER_IP=20
AUTH_RATE_PER_IP_WINDOW_S=900

# --- Widget / worker ---------------------------------------------------------
WIDGET_CONFIG_CACHE_S=300
WORKER_POLL_INTERVAL_MS=15000
NOTIFICATION_MAX_ATTEMPTS=8

# --- Host-side test runner ---------------------------------------------------
# Used by `npm test` when running vitest outside the containers.
TEST_DATABASE_URL=postgres://buginbox:change-me-locally@127.0.0.1:55432/buginbox_test
TEST_REDIS_URL=redis://127.0.0.1:56379/1
